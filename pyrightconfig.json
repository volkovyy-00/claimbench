// basedpyright settings (a pyright fork: the same checker, plus a baseline).
// `basedpyright` locally runs exactly what CI runs.
//
// Only the four pipeline modules; tests/ is not type-checked yet.
// .basedpyright/baseline.json lists the 1 error EV-15 left (tag_pipeline._plain's
// hasattr guard, kept as written), so only NEW errors fail. Fixing it shrinks the file:
// a local run rewrites it, commit that change.
{
  "include": ["golden_set_pipeline.py", "tag_pipeline.py", "retrieval_pipeline.py", "eval_pipeline.py"],
  "pythonVersion": "3.10",
  "typeCheckingMode": "standard"
}
