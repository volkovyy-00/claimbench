# Copy this file to .env and fill in your values.
# golden_set_pipeline.py reads these via LLMClient.from_env().

# OpenRouter's chat-completions endpoint. Matches the OpenAI-compatible
# shape call_llm() already speaks (Bearer auth, /chat/completions,
# choices[0].message.content) - no code changes needed.
LLM_BASE_URL=https://openrouter.ai/api/v1

# Your OpenRouter API key: https://openrouter.ai/settings/keys
LLM_API_KEY=changeme

# gpt-oss on OpenRouter, using the larger/more capable variant. The
# smaller alternative is openai/gpt-oss-20b (cheaper/faster, weaker
# reasoning - riskier for evidence-matching accuracy).
# LLM_MODEL drives `extract` and `build` only. tag_pipeline.py pins its
# own model in code and ignores this value: `python tag_pipeline.py draft`
# uses google/gemini-3.1-pro-preview (_BUNDLE_MODEL) and needs only
# LLM_BASE_URL and LLM_API_KEY.
LLM_MODEL=openai/gpt-oss-120b

# --- Embeddings (retrieval_pipeline.py only) ---
# OpenAI-compatible /embeddings endpoint. OpenRouter now; an on-prem model
# later — only these values change. Any embedding model works; the model
# string is not referenced anywhere in code.
EMBED_BASE_URL=https://openrouter.ai/api/v1
EMBED_API_KEY=changeme
EMBED_MODEL=baai/bge-m3
# Set true ONLY for an asymmetric model that requires an input_type body key
# (e.g. an on-prem nv-embedqa-e5-v5 NIM). Off for OpenRouter — sending an
# unknown input_type there risks a 400.
EMBED_ASYMMETRIC=false
